# 복사해서 .env.local 로 쓰기 (커밋 금지). 값은 팀 채널에서 받기
# LLM = 래블업 토큰팩토리 (OpenAI 호환 가정: {LLM_BASE_URL}/chat/completions). 셋 다 있어야 진짜 LLM, 하나라도 없으면 가짜 응답
# 주소·키·모델 이름은 해커톤 래블업 안내(팀 채널)에서. 예: LLM_BASE_URL=https://.../v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 응답 기다리는 최대 시간(ms). 넘으면 가짜 응답으로 대체 (기본 12000)
LLM_TIMEOUT_MS=

# 코끼리 목소리 (타입캐스트). 키는 서버에서만 쓰인다
# 팀원 계정 키 여러 개를 쉼표로 — 크레딧·동시요청(계정당 2개)을 나눠 쓰고, 다 떨어지면 다음 키로 자동 전환
TYPECAST_API_KEYS=
# (키 하나만 쓸 때)
TYPECAST_API_KEY=
# 개발 중 크레딧 아끼기: off면 아동 목소리 대신 브라우저 목소리 (고정 대사 mp3는 그대로 나옴)
# 배포 서버(Vercel)에는 이 줄을 넣지 않는다
TTS_CLOUD=off
# 남은 크레딧 확인: bash scripts/tts-credits.sh
# 기본 목소리를 바꿀 때만 — 비우면 코드 기본값(하율) 사용. 목록은 src/lib/voice/voices.ts
TYPECAST_VOICE_ID=
